@{
    ViewData["Title"] = "Guides";
}

<section class="tc-page-hero tc-page-hero-guides">
    <div class="container">
        <div class="tc-kicker">KNOWLEDGE BASE</div>
        <h1>Guides</h1>
        <p>Quick answers for installation, progression and the rules that define TrinityConquer Era 1.</p>
    </div>
</section>

<section class="tc-guide-shell">
    <div class="container">
        <div class="tc-section-heading">
            <div class="tc-kicker">GETTING STARTED</div>
            <h2>Common questions</h2>
            <p>These guides cover the issues players are most likely to encounter before and during their first sessions.</p>
        </div>

        <div class="tc-guide-list" id="guideAccordion">
            <div class="tc-guide-item">
                <button class="tc-guide-question" type="button" data-toggle="collapse" data-target="#guideServerDat"
                        aria-expanded="true" aria-controls="guideServerDat">
                    The client says “Failed to open server.dat”
                </button>
                <div id="guideServerDat" class="collapse show" data-parent="#guideAccordion">
                    <div class="tc-guide-answer">
                        <p>Launch TrinityConquer through the official launcher and make sure the client folder is writable.</p>
                        <img src="~/images/ErrorServerDat.png" alt="server.dat error example" class="img-fluid tc-guide-image" />
                    </div>
                </div>
            </div>

            <div class="tc-guide-item">
                <button class="tc-guide-question collapsed" type="button" data-toggle="collapse" data-target="#guidePatch"
                        aria-expanded="false" aria-controls="guidePatch">
                    A patch fails while the launcher is updating
                </button>
                <div id="guidePatch" class="collapse" data-parent="#guideAccordion">
                    <div class="tc-guide-answer">
                        Close every running <strong>TrinityConquerLoader.exe</strong> process, reopen the launcher and let it retry the update.
                    </div>
                </div>
            </div>

            <div class="tc-guide-item">
                <button class="tc-guide-question collapsed" type="button" data-toggle="collapse" data-target="#guideEconomy"
                        aria-expanded="false" aria-controls="guideEconomy">
                    How does the Era 1 economy work?
                </button>
                <div id="guideEconomy" class="collapse" data-parent="#guideAccordion">
                    <div class="tc-guide-answer">
                        The economy is centered on hunting, Dragon Balls, Meteors, Silver and physical Market trading.
                        TrinityConquer does not use the later progression systems that dominate newer Conquer versions.
                    </div>
                </div>
            </div>

            <div class="tc-guide-item">
                <button class="tc-guide-question collapsed" type="button" data-toggle="collapse" data-target="#guideAutoHunt"
                        aria-expanded="false" aria-controls="guideAutoHunt">
                    How does Auto Hunt work?
                </button>
                <div id="guideAutoHunt" class="collapse" data-parent="#guideAccordion">
                    <div class="tc-guide-answer">
                        Auto Hunt is a quality-of-life feature kept by project decision. Auto Jump requires VIP 3+ and Auto Pick Up requires VIP 4+.
                    </div>
                </div>
            </div>

            <div class="tc-guide-item">
                <button class="tc-guide-question collapsed" type="button" data-toggle="collapse" data-target="#guideRemoved"
                        aria-expanded="false" aria-controls="guideRemoved">
                    Which modern systems are disabled?
                </button>
                <div id="guideRemoved" class="collapse" data-parent="#guideAccordion">
                    <div class="tc-guide-answer">
                        Chi, SubClass, Talismans, Mounts, Clans and Martial Arsenal are not part of the playable Era 1 ruleset.
                        The adapted 5695 client can still display some legacy interface elements, but the server blocks removed systems.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
