@model ConquerSite.Models.DTOs.HomePageDTO
@{
    ViewData["Title"] = "Era 1";
    var status = Model.Status;
    string apiState = status.ApiOnline ? "Online" : "Unavailable";
    string gameState = !status.ApiOnline ? "Unavailable" : (status.GameServerOnline ? "Online" : "Offline");
}

<section class="tc-hero">
    <div class="tc-hero-overlay"></div>
    <div class="container tc-hero-content">
        <div class="tc-kicker">PLACEBO</div>
        <h1>ERA 1</h1>
        <p class="tc-hero-lead">Old-school progression. Classic economy. A Conquer experience inspired by patch 5017.</p>
        <div class="tc-hero-actions">
            <a class="btn tc-btn-primary btn-lg" asp-controller="Home" asp-action="Downloads">Play now</a>
            <a class="btn tc-btn-outline btn-lg" asp-controller="Account" asp-action="Register">Create account</a>
        </div>
        <div class="tc-hero-meta">
            <span>Client 5695 adapted</span>
            <span>Level cap 130</span>
            <span>Classic classes</span>
            <span>Physical Market</span>
        </div>
    </div>
</section>

<section class="tc-status-strip" aria-label="Placebo server status">
    <div class="container">
        <div class="tc-status-grid">
            <div class="tc-status-item">
                <span class="tc-status-label">API</span>
                <strong class="@(status.ApiOnline ? "tc-status-online" : "tc-status-offline")">
                    <i class="tc-status-dot"></i>@apiState
                </strong>
            </div>
            <div class="tc-status-item">
                <span class="tc-status-label">GameServer</span>
                <strong class="@(status.GameServerOnline ? "tc-status-online" : "tc-status-offline")">
                    <i class="tc-status-dot"></i>@gameState
                </strong>
            </div>
            <div class="tc-status-item">
                <span class="tc-status-label">Players online</span>
                <strong>@(status.GameServerOnline ? status.OnlinePlayers.ToString() : "—")</strong>
            </div>
            <div class="tc-status-item">
                <span class="tc-status-label">Uptime</span>
                <strong>@status.UptimeLabel</strong>
            </div>
            <div class="tc-status-item">
                <span class="tc-status-label">Client patch</span>
                <strong>@status.ClientPatch</strong>
            </div>
        </div>
        @if (status.ApiOnline && status.LastHeartbeatUtc.HasValue)
        {
            <div class="tc-status-updated">
                Last GameServer heartbeat: @status.LastHeartbeatUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
            </div>
        }
    </div>
</section>

@if (ViewBag.Message != null)
{
    <section class="container tc-message-stack">
        @foreach (Message msg in ViewBag.Message)
        {
            <div class="alert alert-@msg.Type.ToString().ToLower()" role="alert">@msg.Text</div>
        }
    </section>
}

<section class="tc-section tc-section-dark" id="era1">
    <div class="container">
        <div class="tc-section-heading">
            <div class="tc-kicker">THE RULESET</div>
            <h2>Built around the Era 1 experience</h2>
            <p>We keep the progression, combat loop and economy focused on the systems that define classic Conquer.</p>
        </div>

        <div class="row tc-feature-grid">
            <div class="col-md-6 col-lg-3">
                <article class="tc-card">
                    <div class="tc-card-index">01</div>
                    <h3>Classic classes</h3>
                    <p>Trojan, Warrior, Archer, Fire Taoist and Water Taoist.</p>
                </article>
            </div>
            <div class="col-md-6 col-lg-3">
                <article class="tc-card">
                    <div class="tc-card-index">02</div>
                    <h3>Reborn progression</h3>
                    <p>Classic reborn progression with a level cap of 130.</p>
                </article>
            </div>
            <div class="col-md-6 col-lg-3">
                <article class="tc-card">
                    <div class="tc-card-index">03</div>
                    <h3>Player economy</h3>
                    <p>Physical Market, classic currencies and an economy designed around hunting and trading.</p>
                </article>
            </div>
            <div class="col-md-6 col-lg-3">
                <article class="tc-card">
                    <div class="tc-card-index">04</div>
                    <h3>Classic competition</h3>
                    <p>Guild War, PK systems, Nobility and Arena without modern progression layers.</p>
                </article>
            </div>
        </div>
    </div>
</section>

<section class="tc-section tc-section-paper">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <div class="tc-image-frame">
                    <img src="~/images/ServerImage1.png" alt="Placebo gameplay" class="img-fluid" loading="lazy" />
                </div>
            </div>
            <div class="col-lg-6">
                <div class="tc-kicker">WHAT STAYS OUT</div>
                <h2>Less system clutter. More Conquer.</h2>
                <p class="tc-copy-large">Era 1 intentionally removes progression systems that arrived later and changed the original power curve.</p>
                <div class="tc-tag-list">
                    <span>No Chi</span>
                    <span>No SubClass</span>
                    <span>No Talismans</span>
                    <span>No Mounts</span>
                    <span>No Clans</span>
                    <span>No Arsenal</span>
                </div>
                <p class="tc-muted-copy">The 5695 client may still display legacy interface elements, but removed systems remain inaccessible in gameplay.</p>
            </div>
        </div>
    </div>
</section>

<section class="tc-section tc-section-dark">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <div class="tc-kicker">QUALITY OF LIFE</div>
                <h2>Classic foundation, carefully modernized</h2>
                <p class="tc-copy-large">The server keeps its Era 1 identity while adding technical improvements where they do not replace the core game.</p>
                <div class="row tc-mini-features">
                    <div class="col-sm-6"><strong>Auto Hunt V2</strong><span>VIP-gated automation with controlled pickup and movement.</span></div>
                    <div class="col-sm-6"><strong>Launcher updates</strong><span>Incremental client updates through the Placebo launcher.</span></div>
                    <div class="col-sm-6"><strong>Economy safeguards</strong><span>Server-side controls designed to protect long-term progression.</span></div>
                    <div class="col-sm-6"><strong>Era 1 migration</strong><span>Post-era equipment and systems are actively gated by the server.</span></div>
                </div>
            </div>
            <div class="col-lg-5 mt-4 mt-lg-0">
                <div class="tc-image-frame tc-image-frame-small">
                    <img src="~/images/ServerImage3.png" alt="Placebo world" class="img-fluid" loading="lazy" />
                </div>
            </div>
        </div>
    </div>
</section>

<section class="tc-section tc-section-paper tc-home-updates">
    <div class="container">
        <div class="tc-section-heading tc-section-heading-row">
            <div>
                <div class="tc-kicker">LATEST DEVELOPMENT</div>
                <h2>Placebo updates</h2>
                <p>Recent gameplay, client and project changes from the permanent changelog.</p>
            </div>
            <a class="tc-text-link" asp-controller="Home" asp-action="Updates">View all updates →</a>
        </div>
        <div class="row">
            @foreach (var post in Model.LatestUpdates)
            {
                <div class="col-lg-4 mb-4">
                    <article class="tc-home-update-card">
                        <div class="tc-update-meta">
                            <span>@post.Category</span>
                            <time datetime="@post.PublishedAt.ToString("yyyy-MM-dd")">@post.PublishedAt.ToString("dd MMM yyyy")</time>
                        </div>
                        <h3><a asp-controller="Home" asp-action="Update" asp-route-id="@post.Slug">@post.Title</a></h3>
                        <p>@post.Summary</p>
                        <a class="tc-update-link" asp-controller="Home" asp-action="Update" asp-route-id="@post.Slug">Read update <span>→</span></a>
                    </article>
                </div>
            }
        </div>
    </div>
</section>

<section class="tc-cta">
    <div class="container text-center">
        <div class="tc-kicker">READY TO ENTER?</div>
        <h2>Start your Era 1 character.</h2>
        <p>Download the client, create your account and enter Placebo.</p>
        <div class="tc-hero-actions justify-content-center">
            <a class="btn tc-btn-primary btn-lg" asp-controller="Home" asp-action="Downloads">Download client</a>
            <a class="btn tc-btn-outline btn-lg" asp-controller="Account" asp-action="Register">Create account</a>
        </div>
    </div>
</section>
