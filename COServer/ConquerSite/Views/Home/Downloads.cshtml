@model ConquerSite.Models.DTOs.DowloadsSettings
@{
    ViewData["Title"] = "Download";
}

<section class="tc-page-hero">
    <div class="container">
        <div class="tc-kicker">PLAY PLACEBO</div>
        <h1>Download</h1>
        <p>Install the Placebo client and let the launcher keep your game files up to date.</p>
    </div>
</section>

<section class="tc-download-shell">
    <div class="container">
        <div class="row">
            <div class="col-lg-7 mb-4 mb-lg-0">
                <div class="tc-download-card">
                    <div class="tc-download-version">Current client patch: @Model.GetLastPatch()</div>
                    <h2 class="mt-2">Placebo for Windows</h2>
                    <p class="tc-muted-copy mt-3">
                        Download the complete client if this is your first installation. After installation,
                        start Placebo through the launcher so future patches can be applied automatically.
                    </p>

                    <div class="tc-download-actions">
                        @if (!string.IsNullOrWhiteSpace(Model.GetClientMegaUrl()))
                        {
                            <a class="btn tc-btn-primary btn-lg" href="@Model.GetClientMegaUrl()" target="_blank" rel="noopener noreferrer">
                                Download via MEGA
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.GetClientMediafireUrl()))
                        {
                            <a class="btn tc-btn-outline btn-lg" href="@Model.GetClientMediafireUrl()" target="_blank" rel="noopener noreferrer">
                                MediaFire mirror
                            </a>
                        }
                    </div>

                    <div class="tc-download-note">
                        The adapted 5695 client is used as the technical base for Placebo Era 1.
                        Gameplay rules and progression are controlled by the server.
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="tc-download-card">
                    <div class="tc-kicker">INSTALLATION</div>
                    <h3>Three steps to play</h3>
                    <ol class="tc-step-list mt-4">
                        <li>
                            <strong>Download the full client</strong>
                            Use one of the mirrors and extract or install it in a folder you can write to.
                        </li>
                        <li>
                            <strong>Run the Trinity launcher</strong>
                            The launcher checks the patch manifest and downloads missing updates.
                        </li>
                        <li>
                            <strong>Login and play</strong>
                            Create a game account on the website, then enter your credentials in the client.
                        </li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</section>
