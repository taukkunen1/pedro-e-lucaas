<ul class="navbar-nav">
    @if (Utils.CurrentLoggedAccount(Context.Session) != null)
    {
        <li class="nav-item">
            <a class="nav-link text-dark" title="Manage" asp-action="MyCharacter" asp-controller="Account">Hello @Utils.CurrentLoggedAccount(Context.Session).Username !</a>
        </li>
        <li class="nav-item">
            <form class="form-inline">
                <button type="submit" class="nav-link btn btn-link text-dark" asp-action="Logout" asp-controller="Account">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-action="Register" asp-controller="Account">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-action="Login" asp-controller="Account">Login</a>
        </li>
    }
</ul>
