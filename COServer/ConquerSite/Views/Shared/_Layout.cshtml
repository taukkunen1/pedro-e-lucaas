<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d0b08" />
    <meta name="description" content="Placebo Era 1 - classic Conquer Online progression inspired by patch 5017." />
    <title>@ViewData["Title"] - Placebo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
</head>
<body class="tc-body">
    <header class="tc-header">
        <nav class="navbar navbar-expand-lg navbar-dark tc-navbar">
            <div class="container">
                <a class="navbar-brand tc-brand" asp-controller="Home" asp-action="Index" aria-label="Placebo home">
                    <span class="tc-brand-mark">PLACEBO</span>
                    <span class="tc-brand-era">ERA 1</span>
                </a>

                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#placeboNavbar"
                        aria-controls="placeboNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="placeboNavbar">
                    <ul class="navbar-nav mr-auto tc-main-nav">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Downloads">Play</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="ServerInfo">Server Info</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Guides">Guides</a></li>
                        <li class="nav-item">
                            <a class="nav-link" href="https://discord.com/channels/961660468907364352/961660469473599569"
                               target="_blank" rel="noopener noreferrer">Discord</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="tc-main">
        @RenderBody()
    </main>

    <footer class="tc-footer">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-7">
                    <div class="tc-footer-brand">PLACEBO <span>ERA 1</span></div>
                    <p class="mb-0">Classic progression inspired by patch 5017, running on an adapted 5695 client.</p>
                </div>
                <div class="col-md-5 text-md-right mt-3 mt-md-0">
                    <a asp-controller="Home" asp-action="Downloads">Download</a>
                    <a asp-controller="Home" asp-action="ServerInfo">Server Info</a>\n                    <a asp-controller="Home" asp-action="Guides">Guides</a>
                    <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </div>
            <div class="tc-footer-bottom">&copy; @DateTime.UtcNow.Year Placebo. Fan-made private server project.</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
