@{
    ViewData["Title"] = "My Character";
    Character c = (Character)ViewBag.Character;
    string uid = c.UID.ToString();
    string uidMask = uid.Length > 4 ? "****" + uid.Substring(uid.Length - 4) : "****";
}

<section class="tc-page-hero tc-page-hero-account">
    <div class="container">
        <div class="tc-kicker">ACCOUNT DASHBOARD</div>
        <h1>My Character</h1>
        <p>Your current TrinityConquer character at a glance.</p>
    </div>
</section>

<section class="tc-account-shell">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 mb-4 mb-lg-0">
                <article class="tc-character-card">
                    <div class="tc-character-avatar">
                        <img src="@ViewBag.CharacterAvatar" alt="@ViewBag.Character.Name" />
                    </div>
                    <div class="tc-character-body">
                        <div class="tc-kicker">ACTIVE CHARACTER</div>
                        <h2>@ViewBag.Character.Name</h2>
                        <p>@ViewBag.CharacterClassName · Level @ViewBag.Character.Level</p>
                        <div class="tc-character-id">UID @uidMask</div>
                    </div>
                </article>
            </div>

            <div class="col-lg-8">
                <div class="row tc-stat-grid">
                    <div class="col-sm-6 mb-4">
                        <article class="tc-stat-card">
                            <span>Level</span>
                            <strong>@ViewBag.Character.Level</strong>
                        </article>
                    </div>
                    <div class="col-sm-6 mb-4">
                        <article class="tc-stat-card">
                            <span>Class</span>
                            <strong>@ViewBag.CharacterClassName</strong>
                        </article>
                    </div>
                    <div class="col-sm-6 mb-4">
                        <article class="tc-stat-card">
                            <span>Reborn</span>
                            <strong>@ViewBag.Character.Reborn</strong>
                        </article>
                    </div>
                    <div class="col-sm-6 mb-4">
                        <article class="tc-stat-card">
                            <span>Donation Points</span>
                            <strong>@ViewBag.Character.RacePoints</strong>
                        </article>
                    </div>
                </div>

                <div class="tc-account-note">
                    More character information, rankings and security controls will be added to this dashboard in the next website phases.
                </div>
            </div>
        </div>
    </div>
</section>
