@{
    ViewData["Title"] = "My Character";
    Character c = (Character)ViewBag.Character;
    int UidLenght = c.UID.ToString().Length;
    string UidMask = c.UID.ToString();
    UidMask = "****" + UidMask.Substring(UidMask.Length - 4, 3);
}

<div class="container">
    <div class="row my-3">
        <div class="col-lg-4">
            <div class="card">
              <img src="@ViewBag.CharacterAvatar" class="card-img-top" alt="" style="height: 130px;object-fit: contain;">
              <div class="card-body">
                <h5 class="card-title">@ViewBag.Character.Name</h5>
                <hr />
                <div>UID: @UidMask</div>
                <div>Level: @ViewBag.Character.Level</div>
                <div>Class: @ViewBag.CharacterClassName</div>
                <div>Reborn: @ViewBag.Character.Reborn</div>
                <div>DonationPoints: @ViewBag.Character.RacePoints</div>
                <div class="alert alert-info mt-3" role="alert">
                    UID Partially hidden for security
                </div>
              </div>
              <div class="card-body d-none">
                <a href="#" class="card-link">Card link</a>
                <a href="#" class="card-link">Another link</a>
              </div>
            </div>
        </div>
    </div>
</div>