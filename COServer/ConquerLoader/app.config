<?xml version="1.0"?>
<configuration>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup>
<appSettings>
  <!-- URL publicada pela API (DFAPI). Trocar para o dominio/IP definitivo antes de distribuir o launcher. -->
  <add key="ManifestUrl" value="http://localhost:8080/api/clientupdate/manifest" />
</appSettings>
</configuration>
