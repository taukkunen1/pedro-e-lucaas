using Core.Interfaces.GameServer;
using Core.Models.GameServer;
using Newtonsoft.Json;
using RestSharp;
using System.Collections.Generic;

namespace Core
{
    public static class RestApiHelper
    {
        public static ushort ApiPort = 8080;
        public static string ApiRequestBaseURI = $"http://localhost:{ApiPort}/api/";
        private static RestClient ResClient = new RestClient(ApiRequestBaseURI);
        public static void Init()
        {
            ApiRequestBaseURI = $"http://localhost:{ApiPort}/api/";
            ResClient = new RestClient(ApiRequestBaseURI);
        }
        #region General
        public static bool PostRequestSuccessful<T>(string Endpoint, T Data)
        {
            RestRequest ResRequest = new RestRequest(Endpoint, Method.Post);
            ResRequest.AddJsonBody((object)Data);
            ResRequest.RequestFormat = DataFormat.Json;
            var res = ResClient.ExecuteAsync(ResRequest).Result;
            return res.IsSuccessful;
        }
        public static string PostRequestRaw<T>(string Endpoint, T Data)
        {
            RestRequest ResRequest = new RestRequest(Endpoint, Method.Post);
            ResRequest.AddJsonBody((object)Data);
            ResRequest.RequestFormat = DataFormat.Json;
            var res = ResClient.ExecuteAsync(ResRequest).Result;
            return res.Content;
        }
        public static T PostRequest<T>(string Endpoint, T Data)
        {
            RestRequest ResRequest = new RestRequest(Endpoint, Method.Post);
            ResRequest.AddJsonBody((object)Data);
            ResRequest.RequestFormat = DataFormat.Json;
            string JSON = ResClient.ExecuteAsync(ResRequest).Result.Content;
            return JsonConvert.DeserializeObject<T>(JSON);
        }
        public static string PutRequestRaw<T>(string Endpoint, T Data)
        {
            RestRequest ResRequest = new RestRequest(Endpoint, Method.Put);
            ResRequest.AddJsonBody((object)Data);
            ResRequest.RequestFormat = DataFormat.Json;
            var res = ResClient.ExecuteAsync(ResRequest).Result;
            return res.Content;
        }
        public static T GetRequest<T>(string Endpoint, Dictionary<string, string> Parameters = null)
        {
            RestRequest ResRequest = new RestRequest(Endpoint, Method.Get);
            
            if (Parameters != null)
            {
                foreach (KeyValuePair<string, string> kvp in Parameters)
                {
                    Parameter p = Parameter.CreateParameter(kvp.Key, kvp.Value, ParameterType.GetOrPost);
                    ResRequest.AddParameter(p);
                }
            }

            string JSON = ResClient.ExecuteAsync(ResRequest).Result.Content;
            var jsonSerializerSettings = new JsonSerializerSettings();
            jsonSerializerSettings.MissingMemberHandling = MissingMemberHandling.Ignore;
            return JsonConvert.DeserializeObject<T>(JSON, jsonSerializerSettings);
        }
        public static T DeleteRequest<T>(string Endpoint, T Data)
        {
            RestRequest ResRequest = new RestRequest(Endpoint, Method.Delete);
            ResRequest.AddJsonBody((object)Data);
            ResRequest.RequestFormat = DataFormat.Json;
            string JSON = ResClient.ExecuteAsync(ResRequest).Result.Content;
            return JsonConvert.DeserializeObject<T>(JSON);
        }
        public static bool DeleteRequestSuccessful<T>(string Endpoint, T Data)
        {
            RestRequest ResRequest = new RestRequest(Endpoint, Method.Delete);
            ResRequest.AddJsonBody((object)Data);
            ResRequest.RequestFormat = DataFormat.Json;
            var res = ResClient.ExecuteAsync(ResRequest).Result;
            return res.IsSuccessful;
        }
        #endregion
        #region Players

        public static List<Player> GetPlayers()
        {
            List<Player> players = GetRequest<List<Player>>("Players/Get");
            return players;
        }
        public static Player GetPlayer(uint UID)
        {
            if (UID == 0)
            {
                return null;
            }
            Dictionary<string, string> paramGetPlayer = new()
            {
                { "UID", UID.ToString() }
            };
            Player player = GetRequest<Player>("Players/GetOne", paramGetPlayer);
            return player;
        }
        public static void CreatePlayer(Player Player)
        {
            List<Player> players = [Player];
            PostRequestSuccessful("Players/Set", players);
        }

        public static bool UpdatePlayers(List<Player> players)
        {
            return PostRequestSuccessful("Players/Update", players);
        }

        public static bool UpdatePlayer(Player player)
        {
            return PostRequestSuccessful("Players/Update", new List<Player> { player });
        }

        public static List<PlayerItem> GetPlayerItems(uint EntityID)
        {
            Dictionary<string, string> paramGetPlayer = new()
            {
                { "EntityID", EntityID.ToString() }
            };
            return GetRequest<List<PlayerItem>>("PlayerItems/Get", paramGetPlayer);
        }
        public static int UpdatePlayerItems(UpdatePlayerItem playerItems)
        {
            int affectedRows = 0;
            string responseRaw = PutRequestRaw("PlayerItems/Update", playerItems);
            if (int.TryParse(responseRaw, out int affectedRowsQuery))
            {
                affectedRows += affectedRowsQuery;
            }
            return affectedRows;
        }
        #endregion
